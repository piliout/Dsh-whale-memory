  "topics": {
    "group:100000001": [
      { "id": "t1", "text": "上周一起通关了《雾山五行》的联机副本，卡在最终 BOSS，约好这周继续刷", "lastMentionAt": 1794715200000 },
      { "id": "t2", "text": "阿澄在群里发了个自制的小游戏 Demo，大家试玩后给了不少反馈", "lastMentionAt": 1794628800000 },
      { "id": "t3", "text": "小满推荐了一部新番，白泽说画风不错准备周末补", "lastMentionAt": 1794628800000 },
      { "id": "t4", "text": "群里在聊周末去哪家火锅店，青禾提名了一家新开的川渝火锅", "lastMentionAt": 1794542400000 },
      { "id": "t5", "text": "阿澈分享了他拍的星空照片，大家讨论起观星的最佳季节", "lastMentionAt": 1794542400000 },
      { "id": "t6", "text": "夏栀问有没有人一起打羽毛球，陆离说周末有空", "lastMentionAt": 1794283200000 },
      { "id": "t7", "text": "小七在群里求推荐一本推理小说，木棉推荐了东野圭吾的经典", "lastMentionAt": 1794283200000 },
      { "id": "t8", "text": "群公告更新了线下聚会的初步时间，大家还在协调具体日期", "lastMentionAt": 1793851200000 }
    ],
    "private:100000002": [
      { "id": "p1", "text": "主人说最近加班比较多，让我晚上早点睡别等他", "lastMentionAt": 1794715200000 },
      { "id": "p2", "text": "主人分享了今天路上遇到的一只橘猫，还拍了照片", "lastMentionAt": 1794628800000 },
      { "id": "p3", "text": "约好了周末一起看一部老电影，主人负责选片", "lastMentionAt": 1794542400000 },
      { "id": "p4", "text": "主人提过想学做手冲咖啡，问我有没有入门建议", "lastMentionAt": 1794283200000 }
    ]
  },
